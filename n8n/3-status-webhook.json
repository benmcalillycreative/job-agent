    {
      "id": "729e40ac-edaf-40fd-a85b-6f0123844e56",
      "name": "Validate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "jsCode": "// Only accept known statuses and fields from Sage/Bob.\nconst b = $json.body || {};\nconst allowed = ['queued', 'drafting', 'needs_ben', 'awaiting_approval', 'waiting_human_check', 'submitted', 'skipped', 'failed'];\nif (!b.row_id || !allowed.includes(b.status)) throw new Error('Rejected: missing row_id or unknown status ' + b.status);\nconst f = b.fields || {};\nconst out = { job_id: String(b.row_id), status: b.status };\nfor (const k of ['report_url', 'apply_url', 'platform', 'applied_date']) if (f[k]) out[k] = String(f[k]).slice(0, 500);\nif (b.status === 'submitted' && !out.applied_date) out.applied_date = new Date().toLocaleDateString('en-CA', { timeZone: 'America/Chicago' });\nif (b.note) out.notes = `${new Date().toISOString().slice(0, 10)} ${b.status}: ${b.note}`.slice(0, 500);\nreturn [{ json: out }];"
      }
    },
    {
      "id": "6f5cbb0f-9a6e-43f9-91a2-70a03f20793c",
      "name": "Update Jobs row",
