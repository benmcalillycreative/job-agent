      "name": "Pick next job",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "jsCode": "// Send Sage the best queued job, one at a time, max CAP per day.\nconst CAP = 3; // raise to 5 after testing\nconst tz = { timeZone: 'America/Chicago' };\nconst today = new Date().toLocaleDateString('en-CA', tz);\nconst yesterday = new Date(Date.now() - 86400000).toLocaleDateString('en-CA', tz);\nconst rows = $input.all().map(i => i.json);\nconst busy = ['drafting', 'awaiting_approval', 'waiting_human_check'];\n// A job is \"in flight\" until Sage/Bob report back. Ignore ones stuck since before yesterday.\nif (rows.some(r => busy.includes(r.status) && String(r.dispatched_date || '') >= yesterday)) return [];\nif (rows.filter(r => String(r.dispatched_date || '') === today).length >= CAP) return [];\nconst q = rows.filter(r => r.status === 'queued').sort((a, b) => (Number(b.fit_score) || 0) - (Number(a.fit_score) || 0));\nif (!q.length) return [];\nconst j = q[0];\nreturn [{ json: { job_id: j.job_id, status: 'drafting', dispatched_date: today,\n  apply_url: j.apply_url || j.url, platform: j.platform || 'other', fit_score: j.fit_score } }];"
      }
    },
